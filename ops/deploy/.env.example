# Copy to ops/deploy/.env (gitignored). Placeholders only. NEVER put an API key, token or password here.
# Public hostname(s) GEV may be served on, comma separated (Mike-only: set after choosing the domain).
GEV_ALLOWED_HOSTS=map.example.test
# Sites allowed to frame /?embed=1 (CSP frame-ancestors sources).
GEV_EMBED_FRAME_ANCESTORS=https://www.example.test
# Image tag to run; the rollback procedure sets this to a previous tag.
GEV_IMAGE_TAG=current
