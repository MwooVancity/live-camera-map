CCTV_KINGCOUNTY_ENABLED=0
CCTV_WSDOT_ENABLED=0
CCTV_HK_ENABLED=0
CCTV_VEGVESEN_ENABLED=0
CCTV_CATALONIA_ENABLED=0
CCTV_OTTAWA_ENABLED=0
CCTV_TAIWAN_ENABLED=0
CCTV_NYC_ENABLED=0
CCTV_LITHUANIA_ENABLED=0
CCTV_FLORIDA_ENABLED=0
