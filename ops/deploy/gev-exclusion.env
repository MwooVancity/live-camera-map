# Operator environment for the pinned GEV container (docker run --env-file). Generated from data/exclusion-map.json in session 4.
# Purpose: switch off every source whose permission is restricted/unknown. Verified in code: CCTV_*_ENABLED read at gev/server/providers/cctv/catalog.js:44-48; GEV_LIBRARY_DISABLE read at gev/src/library/proxy.js:76 and enforced at :515-530.
# NOT covered: Austin and Caltrans packs have no switch (gap CCTV-NOSWITCH).
CCTV_TFL_ENABLED=0
CCTV_TXDOT_ENABLED=0
CCTV_TALLINN_ENABLED=0
CCTV_TARKTEE_ENABLED=0
CCTV_WARENDORF_ENABLED=0
