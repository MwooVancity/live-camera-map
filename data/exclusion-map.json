    "weather-tile-reaches-eccc": {
      "answer": "NO",
      "evidence": [
        "gev/server/providers/weather.js:4 const BASE = https://nowcoast.noaa.gov/geoserver/observations/",
        "gev/server/providers/weather.js:351 capabilities URL built from BASE",
        "gev/server/providers/weather.js:546 tile/image upstream URL built from BASE",
        "gev/server/providers/weather.js:434 only /manifest, /tile, /image exist; products are the 4 frozen PRODUCTS (:6-53), all nowCOAST"
      ],
      "note": "No host other than nowcoast.noaa.gov appears in weather.js. ECCC GeoMet is used only by the browser-direct air-quality layer (gev/src/layers/airQuality/source.js:8), which no allowlisted route serves."
    },
    "cctv-frame-media-stream-fetch": {
      "answer": "The upstream URL registered for that camera id in the loaded catalog (source.snapshotUrl or source.url), never a client-supplied URL",
      "evidence": [
        "gev/server/providers/cctv.js:650 /frame/",
        "gev/server/providers/cctv.js:671-673 upstreamCandidate = source?.snapshotUrl || source?.url",
        "gev/server/providers/cctv.js:379 /media/ uses source?.url (live HLS/MJPEG only; stills refused just after, same handler)",
        "gev/server/providers/cctv.js:354-359 /stream/ returns buildStreamPayload(source) (URLs and feed type)"
      ],
      "note": "Which cameras exist depends on the pack env flags (catalog.js:56-195). NYC, Florida, Houston, Lithuania are opt-in (default off); Austin and Caltrans always load. These three routes are NOT allowlisted, so no camera image, stream or stream URL reaches a visitor."
    }
  },
