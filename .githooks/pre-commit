#!/bin/sh
# Commit gate: preflight, harness selftest, unit tests. gev/ immutability is checked when gev/ exists.
# Quiet on success (owner 2026-11-24: 130 lines per commit filled the agent's context); full output only on failure.
set -e
run() { out=$("$@" 2>&1) || { echo "$out"; echo "COMMIT BLOCKED: $* failed"; exit 1; }; }
run node ops/lint/preflight.mjs --offline
run node ops/harness/selftest.mjs
run node --test ops/lint/preflight.test.mjs ops/harness/harness.test.mjs tests/exclusion/exclusion.test.mjs tests/deploy/compose-lint.test.mjs tests/deploy/headers.test.mjs tests/health/health.test.mjs tests/worktree/worktree.test.mjs tests/licensing/licence-evidence.test.mjs tests/registry/new-source.test.mjs tests/registry/new-source-patch.test.mjs
if [ -d gev/.git ]; then run node tests/immutability/check.mjs; fi
# Site tests only when site/ or the registry changed (build 2 s + tests); a broken site test was committed once without this.
if { [ -n "${PRECOMMIT_CHANGED_FILES:-}" ] && echo "$PRECOMMIT_CHANGED_FILES" || git diff --cached --name-only; } | grep -qE '^(site/|data/camera-registry/)'; then
  run sh -c 'cd site && npm run build && npm test'
fi
echo "pre-commit OK"
