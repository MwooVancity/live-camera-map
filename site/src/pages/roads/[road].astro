---
import Base from '../../layouts/Base.astro';
import RoadBlock from '../../components/RoadBlock.astro';
import { SITE_NAME } from '../../config.mjs';
import { cameras as allCameras, countsBy, registryDateOf, sources, loadedDistricts } from '../../lib/data.mjs';
import { curatedRoads, curatedCities, curatedPlaces, slugify, cityRoute as cityRouteOf, isIndexable, roadCams } from '../../lib/pages.mjs';
import { roadSlug } from '../../../../ops/importers/lib/registry.mjs';
import { orderAlongRoad, relatedRoads, nearestCities } from '../../lib/roads.mjs';
import { roadBlocks, loadLive, NEAR_KM } from '../../lib/live.mjs';
import { loadHealth, cityHealth, linkCheckText, statusWords, MEANING } from '../../lib/health.mjs';
import { cleanLabel } from '../../lib/labels.mjs';

export function getStaticPaths() {
  return curatedRoads(allCameras).map((road) => ({ params: { road: roadSlug(road) }, props: { road } }));
}
const { road: slug } = Astro.params;
const { road } = Astro.props;
const cameras = roadCams(allCameras); // California, Oregon, Washington (BC highways are not I-, SR- or US- roads)
const roads = curatedRoads(cameras);
const here = cameras.filter((c) => roadSlug(c.road) === slug);
const n = countsBy(cameras, 'road')[road];
if (here.length !== n) throw new Error(`${road}: ${here.length} cameras by slug but countsBy says ${n}`); // one number, one source
// a road can run through several states: states in south-to-north order of their cameras, each source named, the newest registry date of the states it touches
const states = [...new Map([...here].sort((a, b) => a.lat - b.lat).map((c) => [c.regionSlug, c.regionName])).entries()];
const stateText = states.map(([, n]) => n.replace(/ State$/, '')).join(', ');
const srcs = [...new Set(here.map((c) => c.sourceId))].map((id) => sources.find((s) => s.id === id));
const source = { name: srcs.map((s) => s.name).join('; ') };
const agencyText = srcs.map((s) => s.id === 'caltrans' ? 'Caltrans' : s.name).join(', ');
const registryDate = states.map(([r]) => registryDateOf(r)).sort().at(-1);

const cities = curatedCities(cameras);
// one town name can be in two states (Albany CA and OR): a camera counts for a city page only in the region that page belongs to
const placeOf = new Map(curatedPlaces(cameras).filter((p) => roadCams([{ regionSlug: p.region }]).length).map((p) => [p.city, p.region]));
const paged = (c) => placeOf.get(c.city) === c.regionSlug;
const regionOf = (city) => placeOf.get(city);
const cityRoute = (city) => cityRouteOf(regionOf(city), city);
const byRoad = new Map(roads.map((r) => [r, cameras.filter((c) => c.road === r)]));
const cityOf = new Map(roads.map((r) => [r, new Set(byRoad.get(r).filter(paged).map((c) => c.city))]));
const along = Object.entries(countsBy(here.filter(paged), 'city')).sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
const otherPlaces = Object.keys(countsBy(here, 'city')).length - along.length;
const centre = (list) => ({ lat: list.reduce((s, c) => s + c.lat, 0) / list.length, lon: list.reduce((s, c) => s + c.lon, 0) / list.length });
const centres = cities.map((city) => ({ city, ...centre(cameras.filter((c) => c.city === city && paged(c))) }));
const near = along.length >= 2 ? [] : nearestCities(here, centres.filter((c) => !along.some(([x]) => x === c.city)), 2 - along.length);
const related = relatedRoads(road, roads, byRoad, cityOf);

const ord = orderAlongRoad(here);
const total = ord.groups.reduce((s, g) => s + g.cams.length, 0);
if (total !== n) throw new Error(`${road}: ${total} cameras in the order lists but countsBy says ${n}`);
const live = roadBlocks(slug, here, along.map(([c]) => ({ city: c, slug: slugify(c) })), loadLive(), new Date(), { road, along: ord.along });
const hres = cityHealth(here, loadHealth());
const { block: hb, reason: hReason } = hres;
const dirId = (g) => `dir-${slugify(g.direction) || 'none'}`;
const when = (iso) => iso.slice(0, 16).replace('T', ' ') + ' UTC';
const km = (x) => x.toFixed(1);
const axisText = ord.northish ? 'south to north' : 'west to east';
---
<Base title={`${road} traffic cameras in driving order, ${stateText}, United States: ${n} official links | ${SITE_NAME}`} description={`${n} ${agencyText} traffic cameras on ${road} in driving order for each direction, with the closures, chain controls and message signs on the road linked to their nearest cameras.`} route={`/roads/${slug}/`} crumbs={[{ name: 'Roads', route: '/roads/' }, { name: road, route: `/roads/${slug}/` }]} noindex={!isIndexable(n)}>
  <h1>{road} traffic cameras</h1>
  <p>{n} {agencyText} cameras are listed on {road} in {stateText}, United States: {ord.groups.map((g, i) => <>{i > 0 && ', '}<a href={`#${dirId(g)}`}>{g.cams.length} {g.label === 'Direction not recorded' ? 'with no direction recorded' : g.label.toLowerCase()}</a></>)}. Each name below is a link to the official source, not a picture. Part of <a href="/roads/">traffic cameras by road</a>; <a href="/guides/how-to-read-a-road-page/">how to read this page</a>.</p>
  <p><strong>Do not use this page while driving.</strong></p>
  <p><a class="cta" href="/map/">Open the map</a></p>

  {live.map((b) => <RoadBlock b={b} />)}

  <section data-block="cameras" data-basis="registry" data-count={n} data-source={source.name} data-asof={registryDate}>
    <h2>All {n} cameras on {road}, in estimated driving order</h2>
    <p class="meta">Driving order is estimated from camera positions along the road: each direction is ordered by position along the road's main line (we draw the line of best fit through its cameras), because the postmile in the Caltrans data restarts at every county line and the milepost does not run on one scale across districts. On a winding stretch the order can be off.</p>
    {hb && <p class="meta">Status words. {statusWords()}</p>}
    {ord.groups.map((g) => (<>
      <h3 id={dirId(g)}>{g.label} ({g.cams.length})</h3>
      <ol>{g.cams.map(({ camera: c }) => (
        <li data-camera={c.id}><a href={c.officialUrl} rel="noopener" title={c.name}>{cleanLabel(c)}</a> <span class="meta">{[c.feedType === 'still' ? 'still image' : 'video'].filter(Boolean).join(', ')}.</span>{hb && <> <span class="meta" data-status={hb.statusOf(c.id)} title={`${MEANING[hb.statusOf(c.id)]}${hb.record(c.id)?.lastChecked ? '; last checked ' + when(hb.record(c.id).lastChecked) : ''}`}>Status: {hb.statusOf(c.id)}.</span>{hb.checkedText(c.id) && <span class="meta"> {hb.checkedText(c.id)}.</span>}</>}</li>
      ))}</ol>
    </>))}
  </section>

  <section data-block="road-cities" data-basis="registry" data-source={source.name} data-asof={registryDate}>
    <h2>Cities along {road}</h2>
    {along.length > 0 && <ul class="cols">{along.map(([c, k]) => <li><a href={cityRoute(c)}>{c} traffic cameras</a>: {k} camera{k === 1 ? '' : 's'} on {road}.</li>)}</ul>}
    {near.length > 0 && <><p>{along.length === 0 ? `None of the ${cities.length} cities with their own page has a camera on ${road}.` : `Only ${along.length} city with its own page has a camera on ${road}.`} The nearest city pages are:</p>
      <ul>{near.map((x) => <li><a href={cityRoute(x.city)}>{x.city} traffic cameras</a>: {km(x.km)} km from the closest {road} camera.</li>)}</ul></>}
    {otherPlaces > 0 && <p class="meta">{road} cameras are also in {otherPlaces} other named place{otherPlaces === 1 ? '' : 's'} that {otherPlaces === 1 ? 'has' : 'have'} no page of its own.</p>}
  </section>

  {hb ? (
    <section data-block="health" data-source="World Traffic Cameras health checker" data-asof={hb.asof} data-count={hb.total}>
      <h2>Camera health on {road}</h2>
      <p>Last check {when(hb.asof)}: {hb.counts.reachable} reachable, {hb.counts.stale} stale, {hb.counts.unavailable} unavailable, {hb.counts.unknown} unknown, out of {hb.total} cameras. See <a href="/guides/how-to-read-last-checked-status/">how to read these statuses</a>.</p>
    </section>
  ) : (
    <section data-block="health" data-source="World Traffic Cameras health checker" data-asof="not-checked">
      <h2>Camera health on {road}</h2>
      {hReason === 'stale'
        ? <p>Not checked recently. Our last camera check is more than 24 hours old, so we show no status for these {n} links rather than an old one. See <a href="/guides/how-to-read-last-checked-status/">how to read these statuses</a>.</p>
        : <p>Not checked yet. We have not run our camera checker, so we do not know which of these {n} links work today. See <a href="/guides/how-to-read-last-checked-status/">how to read these statuses</a> for what the checks will report.</p>}
    </section>
  )}

  <section data-block="coverage" data-basis="registry" data-source={source.name} data-asof={registryDate}>
    <h2>Coverage gaps on {road}</h2>
    <ul>{ord.groups.map((g) => <li>{g.label}: {g.gap ? `the largest gap is ${km(g.gap.km)} km, between ${g.gap.from.name} and ${g.gap.to.name}.` : `${g.cams.length} camera, so there is no gap to measure.`}</li>)}</ul>
    <p class="meta">A gap is the straight-line distance between two neighbouring cameras in the order above, for a road that runs {axisText} overall. Source: {source.name}{here.some((c) => c.regionSlug === 'california') ? `, Caltrans districts ${loadedDistricts.join(', ')}` : ''}. Registry date {registryDate}. {linkCheckText(hres)} Closures, chain controls and signs are listed only when one of these cameras is within {NEAR_KM} km.</p>
  </section>

  <h2>Related roads</h2>
  <ul>{related.map((r) => <li><a href={`/roads/${roadSlug(r.road)}/`}>{r.road} traffic cameras</a> ({byRoad.get(r.road).length}){r.shared ? `, shares ${r.shared} ${r.shared === 1 ? 'city' : 'cities'} with ${road}` : `, closest cameras of the two roads are ${km(r.km)} km apart`}</li>)}</ul>
  <h2>Guides</h2>
  <ul>
    <li><a href="/guides/how-to-read-a-road-page/">How to read a road page (driving order, nearest cameras)</a></li>
    <li><a href="/guides/what-live-road-conditions-mean/">What the live road conditions mean</a></li>
    <li><a href="/guides/how-to-read-last-checked-status/">How to read "last checked" status</a></li>
  </ul>
  <script>
    import { isSaved, toggleSaved, storageWorks } from '../../scripts/saved';
    // Save this road page in this browser (no account); the list is on /saved/.
    const h1 = document.querySelector('h1');
    if (h1 && storageWorks()) {
      const url = location.pathname, label = (h1.textContent || '').trim();
      const b = document.createElement('button'); b.type = 'button';
      const paint = () => { const on = isSaved(url); b.textContent = on ? 'Road saved' : 'Save this road'; b.setAttribute('aria-pressed', String(on)); };
      b.addEventListener('click', () => { toggleSaved({ url, label, place: 'Road page' }); paint(); });
      paint(); h1.after(b);
    }
  </script>
</Base>
