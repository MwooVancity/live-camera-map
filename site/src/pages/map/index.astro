---
import Base from '../../layouts/Base.astro';
import { SITE_NAME } from '../../config.mjs';
import { cameras, countsBy } from '../../lib/data.mjs';
import { pageList, curatedCities, regionsWithPages, slugify, GUIDES } from '../../lib/pages.mjs';

// Iframe src always ends in ?embed=1; empty env means the engine is not deployed yet.
const raw = (import.meta.env.PUBLIC_GEV_EMBED_URL || '').trim();
const embed = raw ? raw.split(/[?#]/)[0] + '?embed=1' : '';
const cities = curatedCities(cameras);
const byRegion = countsBy(cameras, 'region');
const byCity = countsBy(cameras, 'city');
const regionName = (slug) => cameras.find((c) => c.regionSlug === slug).regionName;
const regionOf = (city) => cameras.find((c) => c.city === city).regionSlug;
---
<Base title={`Traffic camera map | ${SITE_NAME}`} description={`Map of ${cameras.length} California traffic cameras. Each camera links to its official source. Browse by region or city below.`} route="/map/" crumbs={[{ name: 'Map', route: '/map/' }]}>
  <h1>Traffic camera map</h1>
  <p>The map shows {cameras.length} official traffic camera locations in California. Selecting a camera sends you to the official source; we do not display camera pictures. The same cameras are listed below as plain links, so you can browse without the map: start with <a href="/cameras/">all camera regions</a>, a region hub, or a city.</p>
  {embed
    ? <iframe class="map" title="Traffic camera map" src={embed} sandbox="allow-scripts allow-same-origin" referrerpolicy="no-referrer" loading="lazy"></iframe>
    : <p class="meta">The map engine is not deployed yet. The lists below work now.</p>}
  <h2>Regions</h2>
  <ul>{regionsWithPages(cameras).map((r) => <li><a href={`/cameras/${r}/`}>{regionName(r)} traffic cameras</a> ({byRegion[r]})</li>)}</ul>
  <h2>Cities</h2>
  <ul class="cols">{cities.map((c) => <li><a href={`/cameras/${regionOf(c)}/${slugify(c)}/`}>{c} traffic cameras</a> ({byCity[c]})</li>)}</ul>
  <h2>Roads</h2>
  <p><a href="/roads/">Traffic cameras by road, in driving order</a></p>
  <h2>Guides</h2>
  <ul>{GUIDES.map((g) => <li><a href={`/guides/${g.slug}/`}>{g.title}</a></li>)}</ul>
</Base>
