---
// Beats Argos by: a plain-words Iceland briefing built from our own link check: which official Vegagerdin cameras answered, which pictures changed in the last 24 h, which failed, with the check time; Argos shows no check result or age.
// Helpful: a driver sees which Icelandic camera links work now. Gain: our own timestamped check. HCU: three short sections, source credit, no pictures, no road verdict.
import Base from '../../layouts/Base.astro';
import { SITE_NAME } from '../../config.mjs';
import { cameras } from '../../lib/data.mjs';
import { loadHealth } from '../../lib/health.mjs';
import { loadLive } from '../../lib/live.mjs';
import { icelandBriefing, ICELAND_ROW_ID } from '../../lib/iceland-briefing.mjs';

const b = icelandBriefing({ cams: cameras, health: loadHealth(), row: loadLive().rows.get(ICELAND_ROW_ID) });
const when = (iso) => (iso ? iso.slice(0, 16).replace('T', ' ') + ' UTC' : 'not given');
---
<Base title={`Iceland road camera briefing | ${SITE_NAME}`} description="Which official Icelandic road cameras answered in our last check, which pictures changed in the last 24 hours and which failed." route="/briefing/iceland/" crumbs={[{ name: 'Iceland briefing', route: '/briefing/iceland/' }]} noindex={true}>
  <h1>Iceland road camera briefing</h1>
  {b.state === 'checked' || b.state === 'registry only' ? (
    <>
      <section data-block="iceland-briefing-summary" data-basis={b.healthAsof ? undefined : "registry"} data-source="Icelandic Road and Coastal Administration (Vegagerðin)" data-asof={b.healthAsof || b.asof} data-count={b.total}>
        <h2>{b.total} camera views at {b.stations} stations</h2>
        <p>Camera list imported {b.asof ? b.asof.slice(0, 10) : 'on a date not given'}. This page links to the official pictures; it does not copy them, and it does not say a road is open, clear or safe.</p>
        {b.state === 'checked' ? (
          <p>Our link check ran {when(b.healthAsof)}. Of {b.checked} views checked: {b.counts.reachable} answered with a picture, {b.counts.stale} answered with an old file, {b.counts.unavailable} did not answer. {b.counts.unknown} were not checked in time.</p>
        ) : (
          <p>We have no link check newer than 24 hours, so we show no answer counts rather than old ones.</p>
        )}
      </section>
      {b.state === 'checked' && (
        <section data-block="iceland-briefing-changed" data-source="World Traffic Cameras health checker" data-asof={b.healthAsof} data-count={b.changed.length}>
          <h2>{b.changed.length} pictures changed in the last 24 hours</h2>
          {b.changed.length ? <ul>{b.changed.slice(0, 40).map((x) => <li data-id={x.c.id}><a href={x.c.officialUrl} rel="nofollow noopener">{x.c.name}</a>, changed {when(x.at)}</li>)}</ul> : <p>None. A picture that did not change is not always a dead camera.</p>}
          {b.changed.length > 40 && <p class="meta">Showing 40 of {b.changed.length}.</p>}
        </section>
      )}
      {b.state === 'checked' && (
        <section data-block="iceland-briefing-failed" data-source="World Traffic Cameras health checker" data-asof={b.healthAsof} data-count={b.failed.length}>
          <h2>{b.failed.length} cameras did not answer</h2>
          {b.failed.length ? <ul>{b.failed.map((x) => <li data-id={x.c.id}>{x.c.name}{x.fails > 1 ? `, failed ${x.fails} checks in a row` : ''}</li>)}</ul> : <p>None in the last run.</p>}
        </section>
      )}
      <section data-block="iceland-briefing-credit" data-basis="registry" data-source="Icelandic Road and Coastal Administration (Vegagerðin)" data-asof={b.asof} data-count="1">
        <h2>Credit</h2>
        <p>{b.attribution} Imported {b.asof ? b.asof.slice(0, 10) : 'date not given'}. Not endorsed by the Administration.</p>
      </section>
    </>
  ) : (
    <section data-block="iceland-briefing-summary" data-source="Icelandic Road and Coastal Administration (Vegagerðin)" data-asof="none">
      <h2>No briefing available</h2>
      <p>We show nothing rather than guess: {b.state}.</p>
    </section>
  )}
  <p><a href="/observability/iceland/">Iceland road camera coverage</a> | <a href="/status/">Camera network status</a></p>
</Base>
