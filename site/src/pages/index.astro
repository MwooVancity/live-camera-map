---
import Base from '../layouts/Base.astro';
import { SITE_NAME } from '../config.mjs';
import { cameras, countsBy, registryDate, loadedDistricts } from '../lib/data.mjs';
import { curatedPlaces, regionsWithPages, regionInfo, cityRoute, countriesWithPages, countryName, countryRoute, GUIDES } from '../lib/pages.mjs';
const total = cameras.length;
const places = curatedPlaces(cameras);
const regions = regionsWithPages(cameras);
const byRegion = countsBy(cameras, 'region');
const regionName = (slug) => cameras.find((c) => c.regionSlug === slug).regionName;
const names = regions.map(regionName);
// The list is the curated set of city pages, grouped by region; it is NOT a global ranking (Hong Kong or Toronto can hold more cameras than a listed town), so the heading says what it is.
const groups = [];
for (const p of places) { let g = groups.find((x) => x.region === p.region); if (!g) { g = { region: p.region, name: regionName(p.region), items: [] }; groups.push(g); } g.items.push(p); }
const list = names.length > 1 ? `${names.slice(0, -1).join(', ')} and ${names.at(-1)}` : names[0];
const agencies = regions.map((r) => regionInfo(r).agency).join(' and ');
const byCountry = countsBy(cameras, 'country');
const countryList = countriesWithPages(cameras);
const nCountries = Object.keys(countsBy(cameras, 'country')).length;
const sourcesN = new Set(cameras.map((c) => c.sourceId)).size;
---
<Base title={`Live traffic cameras: ${total} official camera links | ${SITE_NAME}`} description={`${total} traffic cameras in ${list}, each linked to the official ${agencies} source, with the roads covered and when each list was last updated.`} route="/">
  <section class="hero">
    <h1>Free live traffic cameras</h1>
    <p class="lead"><strong>{total}</strong> official camera links in <strong>{nCountries}</strong> countries, each one checked by us. No account, no pictures copied: every name goes to the official source.</p>
    <p class="stats"><span>List updated {registryDate}</span><span>{sourcesN} official sources</span><span>Health checked every few hours</span></p>
    <p class="actions"><a class="cta" href="/map/">Open the map</a> <a class="cta2" href="/cameras/">Browse all cameras</a></p>
  </section>
  <details class="where">
    <summary>Where the counts come from</summary>
    <p>{SITE_NAME} lists {total} traffic cameras in {list}, each one a link to the official source ({regions.map((r) => `${regionName(r)}: ${byRegion[r]}${r === 'california' ? ` from Caltrans districts ${loadedDistricts.join(', ')}` : ` from ${regionInfo(r).agency}`}`).join('; ')}). We show where the cameras are, which roads they cover and when our list was last updated{registryDate ? ` (${registryDate})` : ''}. We do not copy camera pictures.</p>
  </details>
  <h2>Traffic cameras by country</h2>
  <ul class="chips">{countryList.map((c) => <li><a href={countryRoute(c)}>{countryName(c)}</a> <span class="n">{byCountry[c]}</span></li>)}</ul>
  <h2>Traffic cameras by city</h2>
  <div class="city-groups">
    {groups.map((g) => (
      <section>
        <h3>{g.name}</h3>
        <ul>{g.items.map((p) => <li><a href={cityRoute(p.region, p.city)}>{p.city} traffic cameras</a> <span class="n">({p.n})</span></li>)}</ul>
      </section>
    ))}
  </div>
  <p><a href="/cameras/">All countries and regions</a> | <a href="/roads/">Cameras by road</a> | <a href="/status/">Camera network status</a> | <a href="/saved/">Your saved cameras</a></p>
  <h2>Guides</h2>
  <ul>{GUIDES.map((g) => <li><a href={`/guides/${g.slug}/`}>{g.title}</a></li>)}</ul>
</Base>
<style>
  .hero { padding: 28px 0 8px; }
  .hero h1 { font-size: clamp(2rem, 6vw, 3.2rem); line-height: 1.1; margin: 0 0 12px; letter-spacing: -0.01em; }
  .lead { font-size: 1.2rem; max-width: 40em; }
  .stats { display: flex; flex-wrap: wrap; gap: 8px 10px; padding: 0; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--mut); }
  .stats span { border: 1px solid var(--line); border-radius: 999px; padding: 4px 12px; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .cta2 { display: inline-block; padding: 10px 18px; border: 1px solid var(--cta); border-radius: 6px; color: var(--cta); text-decoration: none; font-weight: 600; }
  .city-groups { display: grid; grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr)); gap: 8px 32px; }
  .city-groups h3 { font-family: var(--font-mono); font-size: 0.8rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--mut); margin: 20px 0 6px; font-weight: 400; }
  .city-groups ul { list-style: none; margin: 0; padding: 0; }
  .city-groups li { padding: 9px 0; border-bottom: 1px solid var(--line); }
  .city-groups .n { color: var(--mut); }
  .chips { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .chips li { border: 1px solid var(--line); border-radius: 999px; background: var(--panel); }
  .chips a { display: inline-flex; align-items: center; min-height: 44px; padding: 0 6px 0 16px; text-decoration: none; }
  .chips .n { color: var(--mut); padding-right: 16px; font-family: var(--font-mono); font-size: 0.85rem; }
  .where { margin: 12px 0 20px; }
  .where summary { cursor: pointer; color: var(--mut); min-height: 44px; display: flex; align-items: center; }
</style>
