---
import Base from '../layouts/Base.astro';
import { SITE_NAME } from '../config.mjs';
import { cameras, countsBy, registryDate, loadedDistricts } from '../lib/data.mjs';
import { curatedCities, slugify, GUIDES } from '../lib/pages.mjs';
const total = cameras.length;
const byCity = countsBy(cameras, 'city');
const cities = curatedCities(cameras);
const regionOf = (city) => cameras.find((c) => c.city === city).regionSlug;
---
<Base title={`Live traffic cameras: ${total} official camera links | ${SITE_NAME}`} description={`${total} traffic cameras in California, each linked to the official Caltrans source, with the roads covered and when the list was last updated.`} route="/">
  <h1>Free live traffic cameras</h1>
  <p>{SITE_NAME} lists {total} traffic cameras in California (Caltrans districts {loadedDistricts.join(', ')}), each one a link to the official source. We show where the cameras are, which roads they cover and when our list was last updated{registryDate ? ` (${registryDate})` : ''}. We do not copy camera pictures.</p>
  <p><a class="cta" href="/map/">Open the map</a></p>
  <h2>Cities with the most cameras</h2>
  <ul class="cols">
    {cities.map((c) => <li><a href={`/cameras/${regionOf(c)}/${slugify(c)}/`}>{c} traffic cameras</a> ({byCity[c]})</li>)}
  </ul>
  <p><a href="/cameras/">All regions</a></p>
  <h2>Guides</h2>
  <ul>{GUIDES.map((g) => <li><a href={`/guides/${g.slug}/`}>{g.title}</a></li>)}</ul>
</Base>
