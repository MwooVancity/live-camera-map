---
import AltCams from '../../../../components/AltCams.astro';
import CameraListTools from '../../../../components/CameraListTools.astro';
import Base from '../../../../layouts/Base.astro';
import { SITE_NAME } from '../../../../config.mjs';
import { countryOf } from '../../../../../../ops/importers/lib/registry.mjs';
import { cameras, countsBy, registryDateOf, sourceOf, loadedDistricts, failedDistricts, bcReport } from '../../../../lib/data.mjs';
import { feedStatus, FEEDS_BY_REGION } from '../../../../lib/live.mjs';
import { regionsWithPages, curatedPlaces, creditLine, cityRoute, regionRoute, countryRoute, isIndexable, regionIsIndexable, GUIDES, regionInfo } from '../../../../lib/pages.mjs';
import { cleanLabel } from '../../../../lib/labels.mjs';
import { corridorsOfRegion } from '../../../../lib/corridors.mjs';
import { loadHealth, cityHealth, linkCheckText, statusWords, MEANING } from '../../../../lib/health.mjs';

export function getStaticPaths() {
  return regionsWithPages(cameras).map((region) => ({ params: { country: countryOf(region).countrySlug, region } }));
}
const { region } = Astro.params;
const country = countryOf(region);
const info = regionInfo(region);
const regionCams = cameras.filter((c) => c.regionSlug === region);
const regionName = info.heading || regionCams[0].regionName;
const total = countsBy(cameras, 'region')[region];
const byCity = countsBy(regionCams, 'city');
const cities = curatedPlaces(cameras).filter((p) => p.region === region);
const allCities = Object.keys(byCity).length;
const source = sourceOf(info.sourceId);
const regionDate = registryDateOf(region);
const feeds = (FEEDS_BY_REGION[region] || []).map((f) => feedStatus(f));
const isCA = region === 'california';
const corridors = corridorsOfRegion(region); // plan item 36 P2-12: corridor pages for this region (none for most)
const named = Object.values(byCity).reduce((s, k) => s + k, 0);
const unnamed = total - named;
const sorted = [...regionCams].sort((a, b) => a.road.localeCompare(b.road) || a.direction.localeCompare(b.direction) || a.name.localeCompare(b.name));
const hres = cityHealth(regionCams, loadHealth());
const hb = hres.block;
const when = (iso) => iso.slice(0, 16).replace('T', ' ') + ' UTC';
const guides = isCA ? GUIDES.slice(0, 3) : [GUIDES.find((g) => g.slug === info.guide), ...GUIDES.filter((g) => ['how-to-read-last-checked-status', 'camera-link-is-dead'].includes(g.slug))].filter(Boolean);
---
<Base title={`${regionName} traffic cameras: ${total} official links | ${SITE_NAME}`} description={`${total} ${regionName} traffic cameras linked to the official source${cities.length ? ', by city' : ''}, with coverage and last update date.`} route={regionRoute(region)} crumbs={[{ name: 'All cameras', route: '/cameras/' }, { name: country.countryName, route: countryRoute(country.countrySlug) }, { name: regionName, route: regionRoute(region) }]} noindex={!regionIsIndexable(cameras, region)}>
  <h1>{regionName} traffic cameras</h1>
  <p class="meta">Part of <a href={countryRoute(country.countrySlug)}>{country.countryName} traffic cameras</a>.</p>
  {isCA
    ? <p>{total} cameras in {allCities} named places, from Caltrans districts {loadedDistricts.join(', ')}. {failedDistricts.length > 0 ? `Districts ${failedDistricts.join(', ')} did not load in the last import, so this list is partial.` : 'All districts loaded in the last import.'}</p>
    : <p>{total} cameras on {Object.keys(countsBy(regionCams, 'road')).length} roads, from the {info.agency} {info.list} ({source.license}), imported {regionDate}. {info.placeText({ named, places: allCities, unnamed, total })}{bcReport && region === 'british-columbia' && bcReport.dropped ? ` We left out ${bcReport.dropped.dupLocation || 0} entries that repeated another camera's position, road and direction.` : ''}</p>}
  {(info.caveats || []).map((c) => <p class="meta">{c}</p>)}
  {info.credit && <p class="meta">{creditLine(source)}</p>}
  {cities.length > 0 && <section data-block="cities" data-basis="registry" data-source={source.name} data-asof={regionDate}>
    <h2>Cities with the most cameras</h2>
    <ul class="cols">{cities.map((p) => <li><a href={cityRoute(region, p.city)}>{p.city} traffic cameras</a> ({p.n})</li>)}</ul>
  </section>}
  {info.listAll && <section data-block="cameras" data-basis="registry" data-count={total} data-source={source.name} data-asof={regionDate}>
    <h2>All {total} cameras</h2>
    <p class="meta">Source: {source.name}. Registry date {regionDate}. {linkCheckText(hres)}</p>
    {hb && <p class="meta">Status words. {statusWords()}</p>}
    <CameraListTools n={sorted.length} roads={Object.entries(countsBy(sorted, 'road')).filter(([r]) => r).sort((a, b) => a[0].localeCompare(b[0]))} hb={hb} />
    <ul data-camera-list>{sorted.map((c) => (
      <li><a href={c.officialUrl} rel="noopener" title={c.name}>{cleanLabel(c)}</a> <span class="meta">{[c.road, c.direction, c.feedType === 'still' ? 'still image' : 'video'].filter(Boolean).join(', ')}.</span>{c.locationText && <span class="meta"> {c.locationText}</span>}{hb && <> <span class="meta" data-status={hb.statusOf(c.id)} title={`${MEANING[hb.statusOf(c.id)]}${hb.record(c.id)?.lastChecked ? '; last checked ' + when(hb.record(c.id).lastChecked) : ''}`}>Status: {hb.statusOf(c.id)}.</span>{hb.checkedText(c.id) && <span class="meta"> {hb.checkedText(c.id)}.</span>}<AltCams c={c} pool={regionCams} hb={hb} /></>}</li>
    ))}</ul>
  </section>}
  {feeds.length > 0 && <section data-block="feed-freshness" data-basis="registry" data-source={isCA ? 'Caltrans CWWP feeds and NOAA National Weather Service, checked by our importers' : `${info.agency} Open511 events feed, checked by our importer`} data-asof={feeds.map((f) => f.asof).filter(Boolean).sort().at(-1) || 'not-fetched'}>
    <h2>Live data freshness</h2>
    <ul>{feeds.map((f) => <li>{f.name}: {f.state}{f.failed.length ? `, districts ${f.failed.join(', ')} did not load` : ''}{f.asof ? `, last fetched ${f.asof.slice(0, 16).replace('T', ' ')} UTC` : ''}. <span class="meta">Shown on city pages only when newer than {f.maxAgeMin} minutes at build.</span></li>)}</ul>
  </section>}
  <p><a class="cta" href="/map/">Open the map</a>{isCA && <> <a href="/roads/">Traffic cameras by road</a></>}</p>
  {corridors.length > 0 && <p>Roads in order along the road: {corridors.map((k, i) => <>{i > 0 && ', '}<a href={`/corridors/${k.def.slug}/`}>{k.def.title} traffic cameras</a> ({k.n})</>)}.</p>}
  <p>Guides: {guides.map((g, i) => <>{i > 0 && ', '}<a href={`/guides/${g.slug}/`}>{g.title}</a></>)}.</p>
</Base>
