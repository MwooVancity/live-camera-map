---
import Base from '../../../layouts/Base.astro';
import { SITE_NAME } from '../../../config.mjs';
import { cameras, countsBy, registryDateOf, sourceOf, loadedDistricts } from '../../../lib/data.mjs';
import { curatedPlaces, curatedRoads, slugify, isIndexable, regionInfo } from '../../../lib/pages.mjs';
import { cityBlocks, nearestCameras, NEAR_KM } from '../../../lib/live.mjs';
import { loadHealth, cityHealth, MEANING, STATUSES } from '../../../lib/health.mjs';
import { roadSlug } from '../../../../../ops/importers/lib/registry.mjs';
import LiveBlock from '../../../components/LiveBlock.astro';

export function getStaticPaths() {
  return curatedPlaces(cameras).map((p) => ({ params: { region: p.region, city: slugify(p.city) }, props: { city: p.city } }));
}
const { region, city: citySlug } = Astro.params;
const { city } = Astro.props;
const info = regionInfo(region);
const regionCams = cameras.filter((c) => c.regionSlug === region);
const here = regionCams.filter((c) => c.city === city);
const regionName = here[0].regionName;
const byCity = countsBy(regionCams, 'city'); // counted inside the region: one place name in two regions never merges
const n = byCity[city];
const roads = Object.entries(countsBy(here, 'road')).sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
const noRoad = n - roads.reduce((s, r) => s + r[1], 0);
const feeds = countsBy(here, 'feedType');
const source = sourceOf(info.sourceId);
const regionDate = registryDateOf(region);
const isCA = region === 'california';
const dirWord = isCA ? 'direction' : 'camera facing';

// Related: the 4 nearest other curated places in the same region (by average camera position); when the region has fewer than
// 4 others, the nearest places of other regions fill the list (so a small region still links 3 or more cities).
const centre = (list) => ({ lat: list.reduce((s, c) => s + c.lat, 0) / list.length, lon: list.reduce((s, c) => s + c.lon, 0) / list.length });
const me = centre(here);
const live = cityBlocks({ lat: me.lat, lon: me.lon, slug: citySlug, region });
const places = curatedPlaces(cameras).filter((p) => !(p.region === region && p.city === city));
const dist = (p) => { const q = centre(cameras.filter((x) => x.regionSlug === p.region && x.city === p.city)); return (q.lat - me.lat) ** 2 + ((q.lon - me.lon) * Math.cos(me.lat * Math.PI / 180)) ** 2; };
const ranked = places.map((p) => ({ p, d: dist(p), same: p.region === region })).sort((a, b) => Number(b.same) - Number(a.same) || a.d - b.d);
const related = ranked.filter((x) => x.same).slice(0, 4).concat(ranked.filter((x) => x.same).length < 4 ? ranked.filter((x) => !x.same).slice(0, 4 - ranked.filter((x) => x.same).length) : []).map((x) => x.p);

const roadsHere = curatedRoads(cameras).map((r) => [r, here.filter((c) => c.road === r).length]).filter(([, k]) => k > 0).sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
const sorted = [...here].sort((a, b) => a.road.localeCompare(b.road) || a.direction.localeCompare(b.direction) || a.name.localeCompare(b.name));
const { block: hb, reason: hReason } = cityHealth(here, loadHealth());
const when = (iso) => iso.slice(0, 16).replace('T', ' ') + ' UTC';
const verified = here.map((c) => c.officialUrlLastVerified).filter(Boolean).sort().at(-1);
const top = roads.slice(0, 3).map(([r, k]) => `${r} (${k})`).join(', ');
// Non-California regions: the other cameras of the region within NEAR_KM of this place's cameras. In BC most cameras have no named
// place (DriveBC gives no city field), so this is how a driver reaches them from here. Every number comes from this list's length.
const nearbyCams = isCA ? [] : nearestCameras(me, regionCams.filter((c) => c.city !== city), 6).filter((x) => x.km <= NEAR_KM);
const guides = isCA
  ? [['how-caltrans-cameras-work', 'How Caltrans traffic cameras work'], ['how-to-read-last-checked-status', 'How to read "last checked" status'], ['camera-link-is-dead', 'What to do if a camera link is dead'], ['what-live-road-conditions-mean', 'What the live road conditions mean']]
  : [[info.guide, `How ${regionName} (${info.agency}) traffic cameras work`], ['how-to-read-last-checked-status', 'How to read "last checked" status'], ['camera-link-is-dead', 'What to do if a camera link is dead']];
---
<Base title={`${city} traffic cameras: ${n} official links | ${SITE_NAME}`} description={`${n} ${info.agency} traffic cameras near ${city}, ${regionName}, on ${roads.length} road${roads.length === 1 ? '' : 's'}${top ? `, mostly ${top}` : ''}. Official links, last updated ${regionDate}.`} route={`/cameras/${region}/${citySlug}/`} crumbs={[{ name: 'All cameras', route: '/cameras/' }, { name: regionName, route: `/cameras/${region}/` }, { name: city, route: `/cameras/${region}/${citySlug}/` }]} noindex={!isIndexable(n)}>
  <h1>{city} traffic cameras</h1>
  <p>{n} {info.agency} cameras are listed near {city} on {roads.length} road{roads.length === 1 ? '' : 's'}: {feeds.still || 0} still-image and {feeds.video || 0} video feeds. Each name below is a link to the official {info.agency} source, not a picture. Part of <a href={`/cameras/${region}/`}>{regionName} traffic cameras</a>.</p>
  <p><a class="cta" href="/map/">Open the map</a></p>

  <section data-block="coverage" data-basis="registry" data-source={source.name} data-asof={regionDate}>
    <h2>Roads covered</h2>
    <ul class="cols">{roads.map(([r, k]) => <li>{r}: {k} camera{k === 1 ? '' : 's'} ({Object.entries(countsBy(here.filter((c) => c.road === r), 'direction')).sort((x, y) => y[1] - x[1] || x[0].localeCompare(y[0])).map(([d, q]) => `${q} ${d}`).join(', ') || `no ${dirWord} recorded`}).</li>)}</ul>
    {noRoad > 0 && <p class="meta">{noRoad} camera{noRoad === 1 ? ' has' : 's have'} no road recorded.</p>}
    {isCA
      ? <p class="meta">Source: {source.name}, districts {loadedDistricts.join(', ')}. Registry date {regionDate}. Link check by us: {verified ? `last verified ${verified}` : 'never run yet'}.</p>
      : <p class="meta">Source: {source.name}. Registry date {regionDate}. {info.agency} gives no city field and no traffic direction: {city} is the place named in these cameras' own names and captions, not a municipal boundary, and "facing" is the way the camera looks. Link check by us: {verified ? `last verified ${verified}` : 'never run yet'}.</p>}
  </section>

  {live.map((b) => <LiveBlock b={b} city={city} />)}

  {hb ? (
    <section data-block="health" data-source="NearbyCams health checker" data-asof={hb.asof} data-count={hb.total}>
      <h2>Camera health</h2>
      <p>Last check {when(hb.asof)}: {hb.counts.reachable} reachable, {hb.counts.stale} stale, {hb.counts.unavailable} unavailable, {hb.counts.unknown} unknown, out of {hb.total} cameras. {STATUSES.map((s) => `${s[0].toUpperCase()}${s.slice(1)} means ${MEANING[s]}.`).join(' ')} See <a href="/guides/how-to-read-last-checked-status/">how to read these statuses</a>.</p>
      <ul class="cols">{hb.roads.map((r) => <li>{r.road}: {r.counts.reachable} reachable, {r.counts.stale} stale, {r.counts.unavailable} unavailable, {r.counts.unknown} unknown (of {r.n}).</li>)}</ul>
    </section>
  ) : (
    <section data-block="health" data-source="NearbyCams health checker" data-asof="not-checked">
      <h2>Camera health</h2>
      {hReason === 'stale'
        ? <p>Not checked recently. Our last camera check is more than 24 hours old, so we show no status for these {n} links rather than an old one. See <a href="/guides/how-to-read-last-checked-status/">how to read these statuses</a>.</p>
        : <p>Not checked yet. We have not run our camera checker, so we do not know which of these {n} links work today. See <a href="/guides/how-to-read-last-checked-status/">how to read these statuses</a> for what the checks will report.</p>}
    </section>
  )}

  <section data-block="cameras" data-basis="registry" data-count={n} data-source={source.name} data-asof={regionDate}>
    <h2>All {n} cameras</h2>
    <ul>
      {sorted.map((c) => (
        <li><a href={c.officialUrl} rel="noopener">{c.name}</a> <span class="meta">{[c.road, c.direction, c.feedType === 'still' ? 'still image' : 'video'].filter(Boolean).join(', ')}.</span>{c.locationText && <span class="meta"> {c.locationText}</span>}{hb && <> <span class="meta" data-status={hb.statusOf(c.id)} title={`${MEANING[hb.statusOf(c.id)]}${hb.record(c.id)?.lastChecked ? '; last checked ' + when(hb.record(c.id).lastChecked) : ''}`}>Status: {hb.statusOf(c.id)}.</span></>}</li>
      ))}
    </ul>
  </section>

  {nearbyCams.length > 0 && (
    <section data-block="nearby-cameras" data-basis="registry" data-count={nearbyCams.length} data-source={source.name} data-asof={regionDate}>
      <h2>{nearbyCams.length} more {info.agency} {nearbyCams.length === 1 ? 'camera' : 'cameras'} within {NEAR_KM} km</h2>
      <ul>{nearbyCams.map((x) => <li><a href={x.camera.officialUrl} rel="noopener">{x.camera.name}</a> <span class="meta">{[x.camera.road, x.camera.direction].filter(Boolean).join(', ')}; {x.km < 1 ? 'under 1' : Math.round(x.km)} km in a straight line from the middle of the {city} cameras.</span>{x.camera.locationText && <span class="meta"> {x.camera.locationText}</span>}</li>)}</ul>
    </section>
  )}

  <h2>Nearby places</h2>
  <ul>{related.map((p) => <li><a href={`/cameras/${p.region}/${slugify(p.city)}/`}>{p.city} traffic cameras</a> ({p.n})</li>)}</ul>
  {roadsHere.length > 0 && <><h2>Roads in {city}</h2>
  <ul>{roadsHere.map(([r, k]) => <li><a href={`/roads/${roadSlug(r)}/`}>{r} traffic cameras</a>: {k} of its cameras {k === 1 ? 'is' : 'are'} near {city}</li>)}</ul></>}
  <h2>Guides</h2>
  <ul>{guides.map(([slug, title]) => <li><a href={`/guides/${slug}/`}>{title}</a></li>)}</ul>
</Base>
