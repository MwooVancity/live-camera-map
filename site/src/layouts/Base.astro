---
import { SITE_NAME, SITE_URL } from '../config.mjs';
const { title, description, route, crumbs = [], noindex = false } = Astro.props;
const canonical = SITE_URL + route;
const trail = [{ name: 'Home', route: '/' }, ...crumbs];
const ld = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: trail.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: SITE_URL + c.route })),
}).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="site-base" content={import.meta.env.PUBLIC_BASE_PATH ?? ''} />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex,follow" />}
  <script type="application/ld+json" set:html={ld}></script>
  <style>
    :root { --fg:#1b1f24; --bg:#fff; --mut:#566; --line:#d9dee3; --link:#0b57d0; --cta:#0b57d0; }
    @media (prefers-color-scheme: dark) { :root { --fg:#e8eaed; --bg:#14171a; --mut:#9aa5b1; --line:#2c333a; --link:#8ab4f8; --cta:#1a73e8; } }
    body { margin:0; font:16px/1.55 system-ui,sans-serif; color:var(--fg); background:var(--bg); }
    header,main,footer { max-width:60rem; margin:0 auto; padding:0 16px; }
    header { display:flex; flex-wrap:wrap; gap:8px 20px; align-items:center; padding-top:12px; padding-bottom:12px; border-bottom:1px solid var(--line); }
    header a.brand { font-weight:700; color:var(--fg); text-decoration:none; }
    a { color:var(--link); }
    nav.crumbs { font-size:.9rem; color:var(--mut); margin:12px 0; }
    h1 { line-height:1.2; } h2 { margin-top:2rem; }
    .cta { display:inline-block; background:var(--cta); color:#fff; padding:10px 18px; border-radius:6px; text-decoration:none; font-weight:600; }
    .meta { color:var(--mut); font-size:.9rem; }
    section[data-block] { border-top:1px solid var(--line); margin-top:1.5rem; padding-top:.5rem; }
    ul.cols { columns:2 16rem; padding-left:1.2rem; } ul.cols li { break-inside:avoid; margin-bottom:.3rem; }
    footer { border-top:1px solid var(--line); margin-top:3rem; padding-top:1rem; padding-bottom:2rem; font-size:.9rem; color:var(--mut); }
    #site-search { position:relative; flex:1 1 14rem; max-width:24rem; }
    #site-search input { width:100%; box-sizing:border-box; padding:8px 10px; min-height:44px; font:inherit; color:var(--fg); background:var(--bg); border:1px solid var(--line); border-radius:6px; }
    #site-search ul { position:absolute; left:0; right:0; top:100%; z-index:5; margin:4px 0 0; padding:0; list-style:none; background:var(--bg); border:1px solid var(--line); border-radius:6px; }
    #site-search li a { display:flex; flex-wrap:wrap; align-items:center; column-gap:.3em; min-height:44px; box-sizing:border-box; overflow-wrap:anywhere; padding:8px 10px; color:var(--fg); text-decoration:none; }
    #site-search li.on a, #site-search li a:hover { background:var(--line); }
    #site-search li span { color:var(--mut); font-size:.9rem; }
    .sr { position:absolute; width:1px; height:1px; overflow:hidden; clip:rect(0 0 0 0); white-space:nowrap; }
    iframe.map { width:100%; height:70vh; border:1px solid var(--line); }
  </style>
</head>
<body>
  <header>
    <a class="brand" href="/">{SITE_NAME}</a>
    <a href="/map/">Map</a>
    <a href="/cameras/">All cameras</a>
    <a href="/guides/how-caltrans-cameras-work/">Guides</a>
    <div id="site-search" role="search">
      <form hidden>
        <label class="sr" for="site-search-box">Search cities, roads and places</label>
        <input id="site-search-box" type="search" placeholder="Search a city, road or place" autocomplete="off" role="combobox" aria-expanded="false" aria-controls="site-search-list" aria-autocomplete="list" />
        <ul id="site-search-list" role="listbox" aria-label="Search results" hidden></ul>
        <div class="sr" role="status" aria-live="polite"></div>
      </form>
      <noscript>Search needs JavaScript. <a href="/cameras/">Cameras by place</a> <a href="/roads/">Cameras by road</a></noscript>
    </div>
  </header>
  <main>
    {crumbs.length > 0 && (
      <nav class="crumbs" aria-label="Breadcrumb">
        {trail.map((c, i) => (<>{i > 0 && ' / '}{i < trail.length - 1 ? <a href={c.route}>{c.name}</a> : <span>{c.name}</span>}</>))}
      </nav>
    )}
    <slot />
  </main>
  <footer>
    <p>Camera data: Caltrans (California Department of Transportation) for California and DriveBC (Government of British Columbia) for British Columbia. Each camera links to the official source. {SITE_NAME} shows no camera images, thumbnails or video: link-out only. California licence terms are not yet confirmed; the British Columbia camera list and road events are under the Open Government Licence - British Columbia, which does not say whether the pictures are covered.</p>
    <p>No ads, no tracking, no third-party scripts or fonts.</p>
  </footer>
  <script>
    import { initSearchUi } from '../lib/search-ui.mjs';
    initSearchUi(document.getElementById('site-search'));
  </script>
</body>
</html>
