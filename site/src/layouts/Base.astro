---
import { SITE_NAME, SITE_URL, NOINDEX_ALL } from '../config.mjs';
import { sourceOf } from '../lib/data.mjs';
const fi = sourceOf('digitraffic'), qc = sourceOf('quebec-mtmd'), tor = sourceOf('toronto-traffic'), cgy = sourceOf('calgary-traffic'), hk = sourceOf('hongkong-traffic'), is = sourceOf('iceland-vegagerdin'), atx = sourceOf('austin-traffic'); // attribution lines come from sources.json (one place), shown only when that source is in the registry
const { title, description, route, crumbs = [], noindex = false } = Astro.props;
const canonical = SITE_URL + route;
const trail = [{ name: 'Home', route: '/' }, ...crumbs];
const ld = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: trail.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: SITE_URL + c.route })),
}).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="site-base" content={import.meta.env.PUBLIC_BASE_PATH ?? ''} />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {NOINDEX_ALL ? <meta name="robots" content="noindex,nofollow" /> : noindex && <meta name="robots" content="noindex,follow" />}
  <script type="application/ld+json" set:html={ld}></script>
  <style>
    /* GEV look (plan item 14): black, cyan accent #4fe3ff, spaced uppercase labels. Dark only, high contrast. */
    :root { color-scheme: dark; --fg:#e6f1f5; --bg:#05090d; --mut:#8fa8b3; --line:#1b2a33; --link:#4fe3ff; --cta:#4fe3ff; --ctatext:#021014; --panel:#0a131a; }
    body { margin:0; font:16px/1.55 system-ui,sans-serif; color:var(--fg); background:var(--bg); }
    header,main,footer { max-width:60rem; margin:0 auto; padding:0 16px; }
    header { display:flex; flex-wrap:wrap; gap:8px 20px; align-items:center; padding-top:12px; padding-bottom:12px; border-bottom:1px solid var(--line); }
    header a.brand { font-weight:700; color:var(--fg); text-decoration:none; }
    :global(a) { color:var(--link); }
    nav.crumbs { font-size:.9rem; color:var(--mut); margin:12px 0; }
    :global(h1) { line-height:1.2; } :global(h2) { margin-top:2rem; }
    :global(button), :global(select) { font: inherit; min-height: 44px; padding: 6px 12px; } /* thumb-sized controls on phones: Save buttons, filters */
    :global(table) { display:block; max-width:100%; overflow-x:auto; border-collapse:collapse; } /* wide tables scroll inside their own box, never the page */
    :global(th), :global(td) { padding:4px 10px 4px 0; text-align:left; vertical-align:top; }
    :global(.filters) { display:flex; flex-wrap:wrap; gap:10px 16px; align-items:center; margin:12px 0; }
    :global(.filters label) { display:flex; flex-direction:column; gap:4px; font-size:0.9rem; }
    :global([data-camera-list] li) { margin-bottom: 8px; }
    :global(.cta) { display:inline-block; background:var(--cta); color:var(--ctatext); padding:10px 18px; border-radius:6px; text-decoration:none; font-weight:700; box-shadow:0 0 18px rgba(79,227,255,.35); }
    header a { font-size:.8rem; letter-spacing:.14em; text-transform:uppercase; }
    header a.brand { font-size:.95rem; letter-spacing:.2em; }
    nav.crumbs { letter-spacing:.04em; }
    :global(button), :global(select), #site-search input { background:var(--panel); color:var(--fg); border:1px solid var(--line); border-radius:6px; }
    :global(button:hover), :global(select:hover) { border-color:var(--cta); }
    :global(a:focus-visible), :global(button:focus-visible), :global(select:focus-visible), #site-search input:focus-visible { outline:2px solid var(--cta); outline-offset:2px; }
    :global(section[data-block]) { background:var(--panel); border:1px solid var(--line); border-radius:8px; padding:12px 16px; }
    :global(h2) { letter-spacing:.02em; }
    :global(.meta) { color:var(--mut); font-size:.9rem; }
    :global(section[data-block]) { margin-top:1.5rem; }
    :global(ul.cols) { columns:2 16rem; padding-left:1.2rem; } :global(ul.cols li) { break-inside:avoid; margin-bottom:.3rem; }
    footer { border-top:1px solid var(--line); margin-top:3rem; padding-top:1rem; padding-bottom:2rem; font-size:.9rem; color:var(--mut); }
    #site-search { position:relative; flex:1 1 14rem; max-width:24rem; }
    #site-search input { width:100%; box-sizing:border-box; padding:8px 10px; min-height:44px; font:inherit; color:var(--fg); background:var(--bg); border:1px solid var(--line); border-radius:6px; }
    #site-search ul { position:absolute; left:0; right:0; top:100%; z-index:5; margin:4px 0 0; padding:0; list-style:none; background:var(--bg); border:1px solid var(--line); border-radius:6px; }
    #site-search li a { display:flex; flex-wrap:wrap; align-items:center; column-gap:.3em; min-height:44px; box-sizing:border-box; overflow-wrap:anywhere; padding:8px 10px; color:var(--fg); text-decoration:none; }
    #site-search li.on a, #site-search li a:hover { background:var(--line); }
    #site-search li span { color:var(--mut); font-size:.9rem; }
    .sr { position:absolute; width:1px; height:1px; overflow:hidden; clip:rect(0 0 0 0); white-space:nowrap; }
    iframe.map { width:100%; height:70vh; border:1px solid var(--line); }
  </style>
</head>
<body>
  <header>
    <a class="brand" href="/">{SITE_NAME}</a>
    <a href="/map/">Map</a>
    <a href="/cameras/">All cameras</a>
    <a href="/guides/how-caltrans-cameras-work/">Guides</a>
    <div id="site-search" role="search">
      <form hidden>
        <label class="sr" for="site-search-box">Search cities, roads and places</label>
        <input id="site-search-box" type="search" placeholder="Search a city, road or place" autocomplete="off" role="combobox" aria-expanded="false" aria-controls="site-search-list" aria-autocomplete="list" />
        <ul id="site-search-list" role="listbox" aria-label="Search results" hidden></ul>
        <div class="sr" role="status" aria-live="polite"></div>
      </form>
      <noscript>Search needs JavaScript. <a href="/cameras/">Cameras by place</a> <a href="/roads/">Cameras by road</a></noscript>
    </div>
  </header>
  <main>
    {crumbs.length > 0 && (
      <nav class="crumbs" aria-label="Breadcrumb">
        {trail.map((c, i) => (<>{i > 0 && ' / '}{i < trail.length - 1 ? <a href={c.route}>{c.name}</a> : <span>{c.name}</span>}</>))}
      </nav>
    )}
    <slot />
  </main>
  <footer>
    <p>Camera data: Caltrans (California Department of Transportation) for California and DriveBC (Government of British Columbia) for British Columbia. Each camera links to the official source. {SITE_NAME} shows no camera images, thumbnails or video: link-out only. California licence terms are not yet confirmed; the British Columbia camera list and road events are under the Open Government Licence - British Columbia, which does not say whether the pictures are covered.{(fi || qc || tor || cgy || hk || is || atx) && <> Credits for the other countries: {[fi, qc, tor, cgy, hk, is, atx].filter(Boolean).map((s, i) => <>{i ? '; ' : ''}{s.attribution} (<a href={s.licenseUrl}>licence</a>)</>)}. Changes by us: road, direction and place are read from the agency text and repeated positions are left out.</>}</p>
    <p>No ads, no tracking, no third-party scripts or fonts.</p>
  </footer>
  <script>
    import { initSearchUi } from '../lib/search-ui.mjs';
    initSearchUi(document.getElementById('site-search'));
  </script>
</body>
</html>
